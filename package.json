{
  "name": "@furayoshi/dsh-ui-models-invert-selection",
  "version": "1.0.0",
  "description": "DeepSeek Harness client plugin: adds an 'Invert selection' button to the fetch-models dialog of the Models settings section, so only the rows that are already in the model list stay checked on a second fetch + add pass.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "models",
    "settings",
    "ui"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FraYoshi/dsh-ui-models-invert-selection.git"
  },
  "bugs": {
    "url": "https://github.com/FraYoshi/dsh-ui-models-invert-selection/issues"
  },
  "homepage": "https://github.com/FraYoshi/dsh-ui-models-invert-selection#readme",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.1.1-rc.2"
  },
  "publishConfig": {
    "access": "public"
  }
}